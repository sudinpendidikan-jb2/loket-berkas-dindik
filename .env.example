# Kata sandi untuk masuk ke halaman admin (/admin)
ADMIN_PASSWORD=gantidenganpassword

# Connection string dari Supabase:
# Project Settings -> Database -> Connection string -> pilih tab "Connection pooling"
# (mode Transaction, biasanya port 6543). Pakai yang ini, bukan yang "Direct connection",
# supaya cocok dengan environment serverless Vercel.
# Contoh format:
# postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
